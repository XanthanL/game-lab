---
import Base from '../../../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { works } from '../../../data/works.json';
import { strings, siteEmail } from '../../../lib/i18n';

const images = import.meta.glob<{ default: ImageMetadata }>('../../../assets/works/*.jpg', { eager: true });

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
const lang = 'zh' as const;
const s = strings(lang);
const meta = images[`../../../assets/works/${w.img}`]?.default;
const mailto = siteEmail
  ? `mailto:${siteEmail}?subject=${encodeURIComponent(`${s.work.emailSubject} ${w.title.zh}`)}`
  : null;
---
<Base lang={lang} title={`${w.title.zh} · 簪三制壶`} description={w.note.zh}>
  <article class="wrap">
    <p class="crumb"><a href="/zh/#works">← {s.work.back}</a></p>
    <div class="detail-split">
      <figure class="detail-fig fade">
        {meta && <Image src={meta} alt={w.alt.zh} widths={[560, 1120]} sizes="(max-width: 900px) 100vw, 560px" format="webp" loading="eager" fetchpriority="high" />}
        <figcaption>{w.numZh} · {w.form.zh}</figcaption>
      </figure>
      <div class="detail-info">
        <p class="detail-num fade">{w.numZh} <span class="num-latin">· {w.numEn}</span></p>
        <h1 class="detail-title">{w.title.zh}</h1>
        <p class="detail-cross">{w.title.en}</p>
        <dl class="specs">
          <div><dt>{s.work.clay}</dt><dd>{w.specs.clay ?? s.work.empty}</dd></div>
          <div><dt>{s.work.capacity}</dt><dd>{w.specs.capacity ?? s.work.empty}</dd></div>
          <div><dt>{s.work.year}</dt><dd>{w.specs.year ?? s.work.empty}</dd></div>
        </dl>
        <p class="specs-pending"><span class="pending">{s.work.specsPending}</span></p>
        <p class="detail-note">{w.note.zh}</p>
        {mailto
          ? <a class="btn-inquire" href={mailto}>{s.work.inquire}</a>
          : <span class="pending">{s.work.inquirePending}</span>}
      </div>
    </div>
  </article>
</Base>
