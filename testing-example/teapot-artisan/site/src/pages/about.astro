---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { strings } from '../lib/i18n';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/works/*.jpg', { eager: true });
const lang = 'en' as const;
const s = strings(lang);
const figMeta = images['../assets/works/tea-tools-bamboo-01.jpg']?.default;
---
<Base lang={lang} title={s.home.about.title} description={s.home.about.description}>
  <article class="section wrap">
    <h1 class="sec-title">{s.home.about.heading}</h1>
    <div class="about-split">
      <div class="about-text fade">
        {s.home.about.body.map((p) => <p>{p}</p>)}
        <div class="pending-block">{s.home.about.pendingBio}</div>
        <p style="margin-top: var(--space-4);">
          <a href="/#works">{s.home.ctaWorks} →</a>
        </p>
      </div>
      <figure class="about-fig fade">
        {figMeta && <Image src={figMeta} alt="A bamboo tea scoop on a bamboo runner, with dried tea leaves." widths={[560, 1120]} sizes="(max-width: 900px) 100vw, 560px" format="webp" loading="lazy" />}
        <figcaption>{s.home.about.figCaption}</figcaption>
      </figure>
    </div>
    <p style="margin-top: var(--space-6); text-align: center;">
      <Seal chars="簪三" />
    </p>
  </article>
</Base>
