# 依赖目录
node_modules/

# 构建输出
dist/
build/

# 环境变量
.env
.env.local
.env.*.local

# 日志文件
.workbuddy/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时数据
.DS_Store
Thumbs.db

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 测试文件
__pycache__/
*.py[cod]
*$py.class

# 临时文件
*.tmp
*.temp

# 浏览器验证产生的截图
*_screenshot.png
*_screenshot.jpg

# 备份文件
*.bak
*.backup

# 本地开发文件
.local-*

# 仅保留必要的文件
# 我们只上传：
# - HTML/CSS/JS文件
# - README.md
# - 配置文件
# - 工作流文件

# 依赖锁文件（无 package.json 时无需提交）
package-lock.json
yarn.lock
pnpm-lock.yaml

# 源码映射（第三方库附带，非站点运行必需）
*.map

# 本地服务器/工具产生的临时产物
*.http
.server*